#!/sbin/openrc-run
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) Delitants
description="AstraX streaming server"
command="/opt/astrax/astrax"
command_args="--config /var/lib/astrax/astrax-config.json --dvb-owner-helper /opt/astrax/dvb-owner-helper"
command_user="astrax:astrax"
supervisor="supervise-daemon"
respawn_delay=3
depend() { need net; }
